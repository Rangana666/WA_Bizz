# Fleet Manager API
PORT=5000
FLEET_URL=https://fleet.wabizz.lk
DOMAIN=wabizz.lk
ADMIN_EMAIL=admin@wabizz.lk
ADMIN_PASSWORD=change_me_strong_admin_password
ALLOWED_ORIGINS=https://fleet.wabizz.lk,https://wabizz.lk

# JWT
JWT_SECRET=change_me_fleet_jwt_secret_minimum_32_chars

# Database (Fleet Manager's own PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=fleet
DB_USER=fleet
DB_PASSWORD=change_me_fleet_db_password

# Stripe (subscription billing)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRICE_STARTER=price_xxxxx     # Stripe price ID for Starter plan
STRIPE_PRICE_GROWTH=price_xxxxx      # Stripe price ID for Growth plan
STRIPE_PRICE_PRO=price_xxxxx         # Stripe price ID for Pro plan

# Hetzner Cloud (VPS provisioning)
HETZNER_API_TOKEN=your_hetzner_api_token
HETZNER_SSH_KEY_ID=your_ssh_key_id_in_hetzner   # Numeric ID from Hetzner dashboard
HETZNER_LOCATION=hel1                             # hel1 (Helsinki) or nbg1 (Nuremberg)

# Cloudflare (DNS management)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_zone_id_for_wabizz_lk

# SSH (fleet manager's private key path inside container)
SSH_PRIVATE_KEY_PATH=/root/.ssh/id_rsa

# Bot repository (where the per-business bot code lives)
BOT_GIT_REPO=gitea.wabizz.lk/wabizz/bot-core.git
BOT_GIT_TOKEN=your_gitea_access_token

# Resend (transactional email)
RESEND_API_KEY=re_your_resend_api_key

# Telegram alerting (optional but recommended)
# Create a bot via @BotFather, add it to a private group, get the chat_id
TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-1001234567890

# Fleet Manager internal token (used by CI pipeline to notify of new builds)
FLEET_MANAGER_TOKEN=change_me_fleet_manager_internal_token

# UptimeRobot (monitoring for each business subdomain)
UPTIMEROBOT_API_KEY=ur_your_uptimerobot_api_key
UPTIMEROBOT_ALERT_CONTACTS=1234567_0_0   # Alert contact ID from UptimeRobot dashboard

# Private Docker registry (for Phase 5 rolling updates)
REGISTRY_URL=registry.wabizz.lk
REGISTRY_USER=wabizz
REGISTRY_PASSWORD=change_me_registry_password
