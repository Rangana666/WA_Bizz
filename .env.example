# Business identity
BUSINESS_ID=biz_0001
BUSINESS_NAME=Mala's Fashion
BUSINESS_TYPE=clothing
SUBDOMAIN=mala

# Evolution API
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=your_secret_evolution_key_here
EVOLUTION_INSTANCE=mala_main

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=wabizz
DB_USER=wabizz
DB_PASSWORD=change_me_strong_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# Bot settings
BOT_ACTIVE=true
SESSION_TTL_SECONDS=1800
BOT_PORT=4000

# Fleet Manager (central)
FLEET_MANAGER_URL=https://fleet.wabizz.lk
FLEET_MANAGER_SECRET=per_server_unique_secret

# Payment — PayHere (Sri Lanka)
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_SANDBOX=true

# Payment — Stripe (optional, for card payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Bank transfer details shown to customer
BANK_NAME=Commercial Bank
BANK_ACCOUNT_NAME=Your Business Name
BANK_ACCOUNT_NUMBER=8001234567
BANK_BRANCH=Colombo

# Dashboard auth
JWT_SECRET=change_me_jwt_secret_minimum_32_chars_long
DASHBOARD_OWNER_EMAIL=owner@example.com
DASHBOARD_OWNER_PASSWORD=change_me_password

# Automated backups — Hetzner Object Storage (S3-compatible)
HOS_BUCKET=wabizz-backups
HOS_ENDPOINT=https://fsn1.your-objectstorage.com
HOS_ACCESS_KEY=your_hos_access_key
HOS_SECRET_KEY=your_hos_secret_key
